# Repository-wide safety net. The Android project has its own MyUmrahJourney/.gitignore (kept unchanged).

# Signing material and secrets: never commit these.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
key.properties
.env
.env.*

# Local machine / IDE / build output
local.properties
.idea/
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
.DS_Store
*.iml
